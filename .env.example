# ---------- Backend ----------
# Local development: SQLite needs no setup.
#   DATABASE_URL=sqlite:///./codebuddy.db
# PostgreSQL (docker-compose, Supabase, Neon, Render, ...). Any of these URL forms works:
#   postgresql+psycopg://user:password@host:5432/dbname
#   postgresql://user:password@host:5432/dbname      (what most providers show; converted automatically)
# For Supabase use the connection string from Project Settings > Database, and keep the password out of git.
DATABASE_URL=sqlite:///./codebuddy.db

# Days a login lasts before the person has to log in again.
SESSION_TTL_DAYS=14
# The login cookie is only sent over HTTPS when this is true. It defaults to true when APP_ENV=production,
# false otherwise (so plain-http local development works). Set it explicitly if you terminate HTTPS elsewhere.
COOKIE_SECURE=

# Comma-separated list of origins allowed to call the API with cookies. Browsers send the page's own origin
# on POST requests and the API refuses any that is not listed here, so in production set this to your site,
# for example https://codebuddy.example.com
CORS_ORIGINS=http://localhost:5173

# Signup and login attempts per client per minute.
RATE_LIMIT_AUTH_PER_MIN=10
# Project and file saves per client per minute (autosave counts).
RATE_LIMIT_PROJECTS_PER_MIN=120
# Failed logins allowed per client and email before a temporary lock, and how long the lock window lasts (seconds).
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900

# ---------- Code execution (Judge0) ----------
# Option A: self-hosted Judge0 CE  -> JUDGE0_URL=http://localhost:2358  (no key needed)
# Option B: RapidAPI Judge0 CE     -> JUDGE0_URL=https://judge0-ce.p.rapidapi.com
#                                     JUDGE0_API_KEY=<your RapidAPI key>
#                                     JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
# Option C: self-hosted Judge0 with authentication enabled (AUTHN_TOKEN) -> set JUDGE0_API_KEY only;
#           it is sent as the X-Auth-Token header. Leave JUDGE0_API_HOST empty.
# Leave JUDGE0_URL empty and the app will show a clear "not configured" message.
JUDGE0_URL=
JUDGE0_API_KEY=
JUDGE0_API_HOST=
# Seconds of CPU time allowed per run (0 = use the Judge0 instance default; must not exceed its maximum).
JUDGE0_CPU_TIME_LIMIT=5
# Judge0 language ids differ between versions. Check GET {JUDGE0_URL}/languages and override if needed.
# Defaults below are Judge0 CE: Python 3.8.1, C (GCC 9.2.0), Java (OpenJDK 13.0.1).
JUDGE0_LANG_PYTHON=71
JUDGE0_LANG_C=50
JUDGE0_LANG_JAVA=62

# ---------- Server ----------
# "production" turns off the interactive API docs.
APP_ENV=development
# Set to true ONLY behind a reverse proxy that sets X-Forwarded-For; otherwise clients could spoof their IP.
TRUST_PROXY=false

# ---------- Buddy AI (LLM) ----------
# LLM_PROVIDER: anthropic | openai_compatible
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Required: no default, because model names change. Example for Anthropic: claude-sonnet-5-5 (check your provider's docs).
LLM_MODEL=
# Required for openai_compatible providers (e.g. https://api.openai.com/v1). Optional override for anthropic.
LLM_BASE_URL=
# Upper bound on the length of one answer, in tokens.
LLM_MAX_TOKENS=1500

# ---------- Rate limits (requests per minute per client) ----------
RATE_LIMIT_EXECUTE_PER_MIN=20
RATE_LIMIT_AI_PER_MIN=15
# Each practice submission runs every test case (6 to 12 runs), so this one is lower.
RATE_LIMIT_SUBMIT_PER_MIN=6

# ---------- Frontend (frontend/.env) ----------
# VITE_API_URL=http://localhost:8000
